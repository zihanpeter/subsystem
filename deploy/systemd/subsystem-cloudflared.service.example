[Unit]
Description=Subsystem Cloudflare Tunnel
After=network.target subsystem-flask.service
Wants=subsystem-flask.service

[Service]
Type=simple
User=<your-linux-user>
WorkingDirectory=<project-root-path>
ExecStart=/usr/local/bin/cloudflared tunnel run --token ${TUNNEL_TOKEN}
Restart=always
RestartSec=3
EnvironmentFile=<project-root-path>/secrets/cloudflared.env

[Install]
WantedBy=multi-user.target
