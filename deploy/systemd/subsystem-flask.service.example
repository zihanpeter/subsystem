[Unit]
Description=Subsystem Flask App
After=network.target

[Service]
Type=simple
User=<your-linux-user>
WorkingDirectory=<project-root-path>
ExecStart=<venv-path>/bin/python deploy/run_local_server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
